{
  "mcpServers": {
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "fabric-mcp": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@microsoft/fabric-mcp@latest", "server", "start", "--mode", "all", "--read-only"],
      "env": {
        "AZURE_TOKEN_CREDENTIALS": "AzureCliCredential"
      }
    },
    "fabric-rti-mcp": {
      "command": "uvx",
      "args": ["microsoft-fabric-rti-mcp"],
      "env": {
        "KUSTO_SERVICE_URI": "${KUSTO_SERVICE_URI:-}",
        "KUSTO_SERVICE_DEFAULT_DB": "${KUSTO_SERVICE_DEFAULT_DB:-}"
      }
    }
  }
}
