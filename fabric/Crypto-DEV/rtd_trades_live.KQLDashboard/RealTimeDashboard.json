      },
      "usedVariables": [
        "_startTime",
        "_endTime"
      ],
      "text": "materialized_view('volume_5m')\n| where bin_start between (_startTime .. _endTime)\n| where symbol in (external_table('dim_pair') | where is_tracked == true | project symbol)\n| project bin_start, symbol, notional\n| order by bin_start asc"
    },
    {
      "id": "9d11b0ea-c77d-40b9-9e13-d31b05aa3ce9",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "a32f5367-dcf0-440f-a450-e2f92db6c905"
      },
      "usedVariables": [
        "_startTime",
        "_endTime"
      ],
      "text": "tracked_whale_trades()\n| where timestamp between (_startTime .. _endTime)\n| project timestamp, symbol, side, qty, price, notional, ord_type\n| order by timestamp desc\n| take 50"
    }
  ],
