{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "b1_trend",
  "position": {
    "x": 340,
    "y": 390,
    "z": 1000,
    "height": 310,
    "width": 920,
    "tabOrder": 1000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "Date.Date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Pair Daily"
                    }
                  },
                  "Property": "Notional"
                }
              },
              "queryRef": "Pair Daily.Notional"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Pair"
                    }
                  },
                  "Property": "Pair"
                }
              },
              "queryRef": "Pair.Pair"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Notional per day by pair (USD)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
