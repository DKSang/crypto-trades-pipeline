{
  "permissions": {
    "allow": [
      "Bash(fab:*)",
      "Bash(sh scripts/fabric-login.sh)",
      "Bash(npx -y @microsoft/fabric-mcp@latest docs:*)",
      "Bash(npx -y @microsoft/fabric-mcp@latest onelake list-workspaces:*)",
      "Bash(az --version)",
      "Bash(az account show:*)"
    ],
    "ask": [
      "Bash(az account get-access-token:*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
